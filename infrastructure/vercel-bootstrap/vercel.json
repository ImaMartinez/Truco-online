{
  "framework": null,
  "installCommand": "node -e \"process.exit(0)\"",
  "buildCommand": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('index.html','public/index.html')\"",
  "outputDirectory": "public",
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"X-Content-Type-Options","value":"nosniff"}]}]
}
