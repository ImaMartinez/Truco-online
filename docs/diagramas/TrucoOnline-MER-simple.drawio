<mxCell id="datos_participacion" value="posición · vida del héroe" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a89d;fontColor=#475a52;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="390" y="585" width="200" height="40" as="geometry"/></mxCell>
